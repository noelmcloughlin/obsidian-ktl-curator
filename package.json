{
  "name": "@noelmcloughlin/lokf-curator",
  "version": "1.1.2",
  "description": "See how far your notes have actually been checked, and record what you decide: a trust report computed from frontmatter, and a review session that puts each source beside its claim and writes your confirm / send back / retire verdict into the notes themselves.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build-vocab": "node scripts/build-vocab.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "check": "npm run build && npm run lint && npm run smoke-test"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "lokf",
    "okf",
    "linked-open-knowledge-format",
    "open-knowledge-format",
    "frontmatter",
    "metadata",
    "linked-data"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "js-yaml": "^4.1.0",
    "obsidian": "latest",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "obsidian": {
      "@codemirror/state": "^6.7.4",
      "@codemirror/view": "^6.43.11"
    }
  }
}
